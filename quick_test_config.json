{
  "model": {
    "model_name": "Llama-3.2-3B-Instruct",
    "device_map": "auto",
    "torch_dtype": "bfloat16"
  },
  "dataset": {
    "dataset_name": "GSM8k",
    "dataset_type": "math",
    "use_custom_prompts": true
  },
  "dynamic_minp": {
    "h_min": 0.0,
    "h_max": 10.0,
    "min_p_min": 0.01,
    "min_p_max": 0.15,
    "use_sliding_window": true,
    "window_size": 20,
    "percentile": 80,
    "initial_h_max": 10.0,
    "min_samples_for_update": 10,
    "entropy_threshold": 2.5,
    "fixed_low_minp": 0.03
  },
  "generation": {
    "max_new_tokens": 256,
    "temperature": 1,
    "do_sample": true,
    "batch_size": 2,
    "enable_batch_generation": true,
    "cot_method": "simple"
  },
  "cot_prompts": {
    "simple": {
      "math": "Let's think step by step and provide the final answer in \\boxed{{}} format.",
      "qa": "Let's think step by step."
    }
  },
  "one_shot": false,
  "evaluation": {
    "save_results": true,
    "output_dir": "/cephfs/shared/sunyifan/Min-p-CoT/dynamics_minp",
    "num_trials": 1,
    "average_results": true
  },
  "voting": {
    "enable_voting": true,
    "num_votes": 3,
    "voting_temperature": 1,
    "voting_strategy": "majority",
    "use_parallel_voting": true,
    "confidence_threshold": 0.5,
    "enable_greedy_fallback": true
  },
  "logging": {
    "enable_detailed_logging": true,
    "log_level": "INFO"
  }
}

