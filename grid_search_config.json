{
  "search_config": {
    "base_config_path": "config.json",
    "output_dir": "grid_search_results/",
    "search_interval": "0.05_interval"
  },
  "search_space": {
    "step_1_values": [0.35,0.4,0.45],
    "step_2_values": [0.05,0.1,0.15],
    "step_3_values": [0.65,0.7,0.75],
    "step_4_values": [0.85,0.9,0.95],
    "temperature_values": [1.0]
  },
  "search_options": {
    "generate_all_combinations": true,
    "max_experiments": 1000,
    "save_intermediate_results": true,
    "continue_on_error": true
  },
  "experiment_settings": {
    "random_seed": 42,
    "num_runs": 3,
    "parallel_execution": false,
    "timeout_per_experiment": 3600,
    "retry_failed_experiments": true,
    "max_retries": 2
  },
  "result_analysis": {
    "sort_by": "accuracy",
    "include_statistics": true,
    "generate_plots": false,
    "export_best_config": true
  }
}